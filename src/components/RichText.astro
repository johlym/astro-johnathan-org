---
import { PortableText } from 'emdash/ui'
import WorkExperienceList from './WorkExperienceList.astro'
import CertificationsList from './CertificationsList.astro'
import HtmlBlock from './portableText/HtmlBlock.astro'

interface Props {
  content: unknown
  class?: string
}

const { content, class: className } = Astro.props

const value = Array.isArray(content) ? content : []
---

{value.length > 0 && (
  <div class={className}>
    <PortableText
      value={value}
      components={{
        type: {
          workExperienceList: WorkExperienceList,
          certificationsList: CertificationsList,
          htmlBlock: HtmlBlock,
        },
      }}
    />
  </div>
)}

---
import { getWorkExperience } from '../lib/content'

interface Props {
  value?: {
    showAll?: boolean
    selectedExperiences?: string[]
  }
  block?: {
    showAll?: boolean
    selectedExperiences?: (string | { id: string })[]
  }
  node?: {
    showAll?: boolean
    selectedExperiences?: string[]
  }
}

const props = Astro.props
const block = props.value ?? props.node ?? props.block ?? { showAll: true }

const formatDate = (iso: string) => {
  const d = new Date(iso)
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
}

let experiences: Awaited<ReturnType<typeof getWorkExperience>> = []

try {
  const selected = block.selectedExperiences ?? []
  if (selected.length > 0) {
    const ids = selected.map((e) =>
      typeof e === 'object' && e && 'id' in e ? String((e as { id: string }).id) : String(e),
    )
    experiences = await getWorkExperience(ids)
  } else {
    experiences = await getWorkExperience()
  }
} catch {
  // fallback to empty
}
---

{experiences.length > 0 && (
  <div class="space-y-4 my-8">
    <h2>Work Experience</h2>
    {experiences.map((exp) => (
      <div class="p-6 bg-zinc-900/40 border border-zinc-900 hover:border-lime-400/30 transition-all rounded-lg">
        <div class="font-heading font-bold text-white">{exp.title}</div>
        <div class="text-sm text-zinc-400 mt-1">{exp.where}</div>
        <div class="text-xs text-zinc-500 font-mono mt-2">
          {formatDate(exp.from)} – {exp.current ? 'Present' : exp.to ? formatDate(exp.to) : ''}
        </div>
        {exp.details && (
          <p class="text-sm text-zinc-400 mt-3 leading-relaxed">{exp.details}</p>
        )}
      </div>
    ))}
  </div>
)}

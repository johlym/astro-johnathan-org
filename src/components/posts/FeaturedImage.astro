---
import { heroImage } from '../../lib/image'

interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
const optimized = heroImage(src);
---

<div class="overflow-hidden">
  <img
    src={optimized}
    alt={alt}
    class="w-full object-cover grayscale hover:grayscale-0 outline-1 -outline-offset-1 outline-white/10"
    loading="eager"
  />
</div>

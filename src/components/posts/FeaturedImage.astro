---
import { heroImage } from '../../lib/image'

interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
const optimized = heroImage(src);
---

<div class="mb-12 overflow-hidden">
  <img
    src={optimized}
    alt={alt}
    class="w-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
    loading="eager"
  />
</div>

---
interface Props {
  page: number
  totalPages: number
  basePath?: string
}

const { page, totalPages, basePath = '/blog' } = Astro.props

function hrefFor(n: number) {
  if (n <= 1) return basePath
  return `${basePath}?page=${n}`
}

/** Build a compact page window: 1 … surrounding … last */
function pageNumbers(current: number, total: number): Array<number | 'ellipsis'> {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1)

  const pages = new Set<number>([1, total, current])
  for (let i = current - 1; i <= current + 1; i++) {
    if (i >= 1 && i <= total) pages.add(i)
  }

  const sorted = [...pages].sort((a, b) => a - b)
  const result: Array<number | 'ellipsis'> = []
  for (let i = 0; i < sorted.length; i++) {
    if (i > 0 && sorted[i]! - sorted[i - 1]! > 1) result.push('ellipsis')
    result.push(sorted[i]!)
  }
  return result
}

const numbers = pageNumbers(page, totalPages)
---

{totalPages > 1 && (
  <div class="mt-16 flex flex-col md:flex-row items-center justify-between gap-6 pt-8 border-t border-zinc-900">
    <p class="font-mono text-xs text-zinc-600">
      Page {page} of {totalPages}
    </p>
    <nav class="flex items-center gap-2" aria-label="Pagination">
      {page > 1 ? (
        <a
          href={hrefFor(page - 1)}
          class="w-10 h-10 flex items-center justify-center bg-zinc-900/40 border border-zinc-800 text-zinc-400 hover:border-lime-400/40 hover:text-lime-400 transition-all no-underline"
          aria-label="Previous page"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </a>
      ) : (
        <span class="w-10 h-10 flex items-center justify-center bg-zinc-900/40 border border-zinc-800 text-zinc-600 cursor-not-allowed" aria-disabled="true">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </span>
      )}

      {numbers.map((n) =>
        n === 'ellipsis' ? (
          <span class="text-zinc-600 px-2">…</span>
        ) : n === page ? (
          <span class="w-10 h-10 flex items-center justify-center bg-lime-400 text-black font-mono text-sm font-bold" aria-current="page">
            {n}
          </span>
        ) : (
          <a
            href={hrefFor(n)}
            class="w-10 h-10 flex items-center justify-center bg-zinc-900/40 border border-zinc-800 text-zinc-400 hover:border-lime-400/40 hover:text-lime-400 transition-all font-mono text-sm no-underline"
          >
            {n}
          </a>
        ),
      )}

      {page < totalPages ? (
        <a
          href={hrefFor(page + 1)}
          class="w-10 h-10 flex items-center justify-center bg-zinc-900/40 border border-zinc-800 text-zinc-400 hover:border-lime-400/40 hover:text-lime-400 transition-all no-underline"
          aria-label="Next page"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      ) : (
        <span class="w-10 h-10 flex items-center justify-center bg-zinc-900/40 border border-zinc-800 text-zinc-600 cursor-not-allowed" aria-disabled="true">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </span>
      )}
    </nav>
  </div>
)}

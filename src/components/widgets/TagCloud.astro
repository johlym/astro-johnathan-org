---
import { getTaxonomyTerms, type TaxonomyTerm } from 'emdash'

interface Props {
  showCount?: boolean | string
  limit?: number | string
}

const { showCount: showCountProp = false, limit: limitProp = 20 } = Astro.props

function asBool(value: unknown, fallback: boolean) {
  if (value === undefined || value === null) return fallback
  if (typeof value === 'boolean') return value
  if (typeof value === 'string') return value === 'true' || value === '1'
  return Boolean(value)
}

const showCount = asBool(showCountProp, false)
const limit = Math.max(1, Number(limitProp) || 20)

let terms: TaxonomyTerm[] = []
try {
  const result = await getTaxonomyTerms('tag', { includeCounts: showCount })
  terms = result.slice(0, limit)
} catch {
  terms = []
}
---

{terms.length > 0 && (
  <ul role="list" class="flex flex-wrap gap-2">
    {terms.map((term) => (
      <li>
        <a
          href={`/blog?tag=${encodeURIComponent(term.slug)}`}
          class="text-zinc-400 text-base sm:text-xs hover:text-lime-400 no-underline lowercase"
        >
          {term.label}
          {showCount && term.count !== undefined && (
            <span class="text-zinc-600 tabular-nums"> ({term.count})</span>
          )}
        </a>
      </li>
    ))}
  </ul>
)}

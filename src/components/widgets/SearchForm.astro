---
interface Props {
  placeholder?: string
}

const { placeholder = 'Search…' } = Astro.props
---

<form action="/search" method="get" class="flex flex-col gap-2" role="search">
  <label class="sr-only" for="widget-search">Search</label>
  <input
    id="widget-search"
    type="search"
    name="q"
    placeholder={placeholder}
    class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 text-sm text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-lime-400/40 font-mono"
  />
  <button
    type="submit"
    class="self-start text-lime-400 text-xs font-mono uppercase tracking-wide hover:text-lime-300"
  >
    Search
  </button>
</form>

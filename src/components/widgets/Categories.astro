---
import type { TaxonomyTerm } from 'emdash'
import { getCategoryTermsWithCounts } from '../../lib/content'

interface Props {
  showCount?: boolean | string
  hierarchical?: boolean | string
}

const { showCount: showCountProp = true, hierarchical: hierarchicalProp = true } = Astro.props

/** Admin widget toggles may arrive as booleans or strings. */
function asBool(value: unknown, fallback: boolean) {
  if (value === undefined || value === null) return fallback
  if (typeof value === 'boolean') return value
  if (typeof value === 'string') return value === 'true' || value === '1'
  return Boolean(value)
}

const showCount = asBool(showCountProp, true)
const hierarchical = asBool(hierarchicalProp, true)

let terms: TaxonomyTerm[] = []
try {
  terms = await getCategoryTermsWithCounts(showCount)
} catch {
  terms = []
}

function flatten(items: TaxonomyTerm[], depth = 0): Array<TaxonomyTerm & { depth: number }> {
  const out: Array<TaxonomyTerm & { depth: number }> = []
  for (const item of items) {
    out.push({ ...item, depth })
    if (hierarchical && item.children?.length) {
      out.push(...flatten(item.children, depth + 1))
    }
  }
  return out
}

const flat = flatten(terms)
---

{flat.length > 0 && (
  <ul role="list" class="flex flex-col gap-2">
    {flat.map((term) => (
      <li class:list={[{ 'pl-3': term.depth > 0 }]}>
        <a
          href={`/blog/${encodeURIComponent(term.slug)}`}
          class="text-neutral-300 text-base sm:text-sm hover:text-lime-400 no-underline lowercase"
        >
          {term.label}
          {showCount && (
            <span class="text-neutral-600 tabular-nums"> ({term.count ?? 0})</span>
          )}
        </a>
      </li>
    ))}
  </ul>
)}

---
import Pagination from '../Pagination.astro'
import type { EmDashPost } from '../../lib/content'
import { getCategoryTermsWithCounts } from '../../lib/content'
import { formatMonthYear, formatShortDate, readingMinutes } from '../../lib/format'
import type { TaxonomyTerm } from 'emdash'

interface Props {
  posts: EmDashPost[]
  page: number
  totalPages: number
  total?: number
  basePath?: string
  /** Shown under the Blog heading (e.g. category label). */
  subtitle?: string
  title?: string
  activeCategory?: string
}

const {
  posts,
  page,
  totalPages,
  total,
  basePath = '/blog',
  subtitle,
  title = 'Blog Archive',
  activeCategory,
} = Astro.props

let categories: TaxonomyTerm[] = []
try {
  categories = await getCategoryTermsWithCounts(true)
} catch {
  categories = []
}

// Prefer categories that have posts; fall back to any known terms
const filterCategories = [...categories]
  .sort((a, b) => (b.count ?? 0) - (a.count ?? 0))
  .filter((c) => c.slug && ((c.count ?? 0) > 0 || categories.every((x) => (x.count ?? 0) === 0)))
  .slice(0, 8)

type MonthGroup = {
  key: string
  label: string
  entries: Array<{
    post: EmDashPost
    date: Date
    minutes: number
  }>
}

const groups: MonthGroup[] = []
const groupMap = new Map<string, MonthGroup>()

for (const post of posts) {
  const date = new Date(post.publishedAt ?? post.createdAt ?? Date.now())
  const key = `${date.getFullYear()}-${String(date.getMonth()).padStart(2, '0')}`
  let group = groupMap.get(key)
  if (!group) {
    group = { key, label: formatMonthYear(date), entries: [] }
    groupMap.set(key, group)
    groups.push(group)
  }
  group.entries.push({
    post,
    date,
    minutes: readingMinutes(post.body),
  })
}

const shown = posts.length
const totalLabel = total ?? shown
---

<header class="py-16 md:py-24 px-6 md:px-12 border-b border-zinc-900 bg-zinc-950">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div>
        <p class="font-mono text-xs text-lime-400 uppercase tracking-widest mb-3">
          {subtitle ? 'Filtered Archive' : 'Complete Archive'}
        </p>
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-white tracking-tight">
          {title}
        </h1>
        {subtitle && (
          <p class="text-zinc-400 text-sm font-mono mt-3 lowercase">{subtitle}</p>
        )}
      </div>
      <p class="text-sm text-zinc-500 font-mono max-w-md">
        All entries indexed chronologically. Filter by category or browse month-by-month.
      </p>
    </div>
  </div>
</header>

{filterCategories.length > 0 && (
  <section class="py-12 px-6 md:px-12 bg-zinc-950 border-b border-zinc-900">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-center gap-3">
        <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider mr-2">Filter:</span>
        <a
          href="/blog"
          class:list={[
            'px-4 py-2 text-xs font-mono transition-all duration-200 no-underline',
            !activeCategory
              ? 'bg-lime-400 text-black'
              : 'bg-zinc-900 text-zinc-400 border border-zinc-800 hover:border-lime-400/40 hover:text-lime-400',
          ]}
        >
          All Posts
        </a>
        {filterCategories.map((cat) => {
          const isActive = activeCategory === cat.slug
          return (
            <a
              href={`/blog/${encodeURIComponent(cat.slug)}`}
              class:list={[
                'px-4 py-2 text-xs font-mono transition-all duration-200 no-underline',
                isActive
                  ? 'bg-lime-400 text-black'
                  : 'bg-zinc-900 text-zinc-400 border border-zinc-800 hover:border-lime-400/40 hover:text-lime-400',
              ]}
            >
              {cat.label}
            </a>
          )
        })}
      </div>
    </div>
  </section>
)}

<section class="py-16 md:py-24 px-6 md:px-12 bg-zinc-950">
  <div class="max-w-7xl mx-auto">
    {posts.length > 0 ? (
      <>
        <div class="mb-10 flex items-center justify-between">
          <p class="font-mono text-xs text-zinc-500">
            Showing <span class="text-lime-400">{shown}</span>
            {totalLabel !== shown && (
              <> of <span class="text-zinc-300">{totalLabel}</span></>
            )}
            {' '}entries
          </p>
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs text-zinc-500">Sort:</span>
            <span class="text-xs font-mono text-lime-400">Newest</span>
          </div>
        </div>

        <div class="space-y-0">
          {groups.map((group) => (
            <div class="mb-12">
              <div class="flex items-center gap-4 mb-6">
                <h2 class="font-heading text-xl font-bold text-white">{group.label}</h2>
                <div class="flex-1 h-px bg-zinc-900"></div>
                <span class="font-mono text-xs text-zinc-600">
                  {group.entries.length} {group.entries.length === 1 ? 'entry' : 'entries'}
                </span>
              </div>
              <div class="space-y-1">
                {group.entries.map(({ post, date, minutes }) => (
                  <a
                    href={`/blog/${post.slug}`}
                    class="archive-entry group flex flex-col md:flex-row md:items-center justify-between p-5 bg-zinc-900/20 border border-zinc-900 hover:border-lime-400/30 hover:bg-zinc-900/40 transition-all duration-300 no-underline"
                  >
                    <div class="flex flex-col md:flex-row md:items-center gap-3 md:gap-6 min-w-0">
                      <time
                        datetime={date.toISOString()}
                        class="font-mono text-xs text-zinc-600 w-24 shrink-0"
                      >
                        {formatShortDate(date)}
                      </time>
                      <h3 class="font-heading font-semibold text-white group-hover:text-lime-400 transition-colors text-pretty">
                        {post.title}
                      </h3>
                    </div>
                    <div class="flex items-center gap-4 mt-3 md:mt-0 shrink-0">
                      {post.category && (
                        <span class="text-[10px] font-mono text-lime-400/70 px-2 py-1 bg-lime-400/10">
                          {post.category}
                        </span>
                      )}
                      <span class="font-mono text-xs text-zinc-600">{minutes} min</span>
                      <svg
                        class="w-4 h-4 text-zinc-700 group-hover:text-lime-400 transition-colors"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>

        <Pagination page={page} totalPages={totalPages} basePath={basePath} />
      </>
    ) : (
      <p class="text-zinc-500 text-sm font-mono">No posts yet.</p>
    )}
  </div>
</section>

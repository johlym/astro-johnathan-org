---
import PostCard from '../PostCard.astro'
import Pagination from '../Pagination.astro'
import type { EmDashPost } from '../../lib/content'

interface Props {
  posts: EmDashPost[]
  page: number
  totalPages: number
  basePath?: string
  /** Shown under the Blog heading (e.g. category label). */
  subtitle?: string
  title?: string
}

const {
  posts,
  page,
  totalPages,
  basePath = '/blog',
  subtitle,
  title = 'Blog',
} = Astro.props
---

<section class="w-full bg-neutral-950 py-16 border-b border-neutral-800">
  <div class="max-w-[1200px] mx-auto px-6 flex flex-col gap-3">
    <p class="text-lime-400 text-base sm:text-xs uppercase tracking-widest font-heading">Archive</p>
    <h1 class="text-neutral-100 text-4xl font-heading text-pretty">{title}</h1>
    {subtitle && (
      <p class="text-neutral-400 text-base sm:text-sm font-heading lowercase text-pretty">
        {subtitle}
      </p>
    )}
  </div>
</section>

<section class="w-full bg-neutral-950 py-12">
  <div class="max-w-[1200px] mx-auto px-6 flex flex-col gap-12">
    {posts.length > 0 ? (
      <>
        <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
          {posts.map((post) => (
            <li class="min-w-0">
              <PostCard
                post={{
                  slug: post.slug,
                  title: post.title,
                  date: new Date(post.publishedAt ?? post.createdAt ?? Date.now()),
                  excerpt: post.excerpt,
                  featuredImage: post.featuredImage,
                }}
              />
            </li>
          ))}
        </ul>
        <Pagination page={page} totalPages={totalPages} basePath={basePath} />
      </>
    ) : (
      <p class="text-neutral-500 text-base sm:text-sm">No posts yet.</p>
    )}
  </div>
</section>

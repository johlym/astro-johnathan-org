---
import { getCertifications } from '../lib/content'

interface Props {
  value?: {
    showAll?: boolean
    selectedCertifications?: string[]
  }
  block?: {
    showAll?: boolean
    selectedCertifications?: (string | { id: string })[]
  }
  node?: {
    showAll?: boolean
    selectedCertifications?: string[]
  }
}

const props = Astro.props
const block = props.value ?? props.node ?? props.block ?? {}

const formatDate = (iso: string) => {
  const d = new Date(iso)
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
}

let certifications: Awaited<ReturnType<typeof getCertifications>> = []

try {
  if (block.selectedCertifications?.length) {
    const ids = block.selectedCertifications.map((e) =>
      typeof e === 'object' && e && 'id' in e ? String((e as { id: string }).id) : String(e),
    )
    certifications = await getCertifications(ids)
  } else if (block.showAll !== false) {
    certifications = await getCertifications()
  }
} catch {
  // fallback to empty
}
---

{certifications.length > 0 && (
  <div class="space-y-4 my-8">
    <h2>Certifications</h2>
    {certifications.map((cert) => (
      <div class="p-4 rounded-md bg-neutral-900 border border-lime-400">
        <div class="font-bold text-lime-400">{cert.name}</div>
        <div class="text-sm text-neutral-300">{cert.issuingBody}</div>
        {cert.issued && (
          <div class="text-sm text-neutral-400 mt-1">
            {formatDate(cert.issued)}
          </div>
        )}
      </div>
    ))}
  </div>
)}

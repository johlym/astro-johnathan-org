---
import NavLink from './NavLink.astro'

type NavItem = { href: string; label: string }

interface Props {
  siteTitle: string
  navLinks?: NavItem[]
}

const { siteTitle, navLinks = [] } = Astro.props
---

<header class="w-full bg-neutral-950 border-b border-neutral-800">
  <nav class="max-w-[1200px] mx-auto px-6 py-6 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 group no-underline shrink-0" aria-label="Homepage">
      <div class="size-8 bg-lime-400 flex items-center justify-center shrink-0">
        <span class="text-neutral-950 text-xs font-bold leading-none">J.<br />ORG</span>
      </div>
      <span class="text-neutral-100 text-sm tracking-tight font-heading lowercase">{siteTitle}</span>
    </a>

    {navLinks.length > 0 && (
      <>
        <div class="hidden lg:flex items-center gap-8">
          {navLinks.map((link) => (
            <NavLink href={link.href} label={link.label} />
          ))}
        </div>

        <details class="relative lg:hidden">
          <summary class="list-none cursor-pointer text-neutral-400 hover:text-lime-400 flex items-center justify-center size-8 [&::-webkit-details-marker]:hidden">
            <span class="sr-only">Open menu</span>
            <svg class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </summary>
          <div class="absolute right-0 top-full mt-3 z-50 min-w-48 bg-neutral-950 border border-neutral-800 p-4 flex flex-col gap-4">
            {navLinks.map((link) => (
              <NavLink href={link.href} label={link.label} />
            ))}
          </div>
        </details>
      </>
    )}
  </nav>
</header>

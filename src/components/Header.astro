---
import Logo from './Logo.astro'
import NavLink from './NavLink.astro'

type NavItem = { href: string; label: string }

interface Props {
  siteTitle: string
  navLinks?: NavItem[]
}

const { siteTitle, navLinks = [] } = Astro.props
---

<nav class="sticky top-0 z-50 py-6 px-6 md:px-12 border-b border-zinc-900/80 bg-zinc-950/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-3 no-underline shrink-0" aria-label="Homepage">
      <Logo siteTitle={siteTitle} />
    </a>

    <div class="flex items-center gap-8">
      {navLinks.length > 0 && (
        <>
          <div class="hidden md:flex items-center gap-8">
            {navLinks.map((link) => (
              <NavLink href={link.href} label={link.label} />
            ))}
          </div>

          <details class="relative md:hidden">
            <summary class="list-none cursor-pointer text-zinc-400 hover:text-lime-400 flex items-center justify-center size-8 [&::-webkit-details-marker]:hidden">
              <span class="sr-only">Open menu</span>
              <svg class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </summary>
            <div class="absolute right-0 top-full mt-3 z-50 min-w-48 bg-zinc-950/95 backdrop-blur-md border border-zinc-800 p-4 flex flex-col gap-4">
              {navLinks.map((link) => (
                <NavLink href={link.href} label={link.label} />
              ))}
              <a
                href="/rss.xml"
                class="inline-flex items-center gap-2 bg-zinc-900 hover:bg-lime-400 hover:text-black border border-zinc-800 text-sm font-medium px-4 py-2 transition-all duration-300 no-underline text-zinc-100"
              >
                <span>Subscribe</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
          </details>
        </>
      )}

      <a
        href="/rss.xml"
        class="hidden sm:inline-flex items-center gap-2 bg-zinc-900 hover:bg-lime-400 hover:text-black border border-zinc-800 text-sm font-medium px-4 py-2 transition-all duration-300 no-underline text-zinc-100"
      >
        <span>Subscribe</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</nav>

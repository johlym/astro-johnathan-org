---
import { thumbImage } from '../../lib/image'
import type { EmDashProject } from '../../lib/content'

interface Props {
  project: EmDashProject
}

const { project } = Astro.props
const href = `/projects/${project.slug}`
const cover = project.images[0]
const coverSrc = cover ? thumbImage(cover.url) : ''
const createdDate = project.created ? new Date(project.created) : null
const created = createdDate && !Number.isNaN(createdDate.getTime()) ? createdDate : null
const year = created ? created.getFullYear() : null
---

<a
  href={href}
  class="group flex flex-col bg-zinc-900/20 border border-zinc-900 hover:border-lime-400/30 transition-all duration-300 no-underline h-full overflow-hidden"
>
  <div class="aspect-[16/10] bg-zinc-900 overflow-hidden">
    {coverSrc ? (
      <img
        src={coverSrc}
        alt={cover?.alt || project.title}
        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-[filter] duration-300"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <span class="font-mono text-[10px] uppercase tracking-widest text-zinc-700">No image</span>
      </div>
    )}
  </div>

  <div class="flex flex-col grow p-6">
    <div class="flex items-center gap-3 text-xs font-mono text-zinc-500 mb-3">
      {year && created && <time datetime={created.toISOString()}>{year}</time>}
      <span
        class:list={[
          'uppercase tracking-wider text-[10px] px-2 py-0.5',
          project.active ? 'bg-lime-400/10 text-lime-400' : 'bg-zinc-800 text-zinc-500',
        ]}
      >
        {project.active ? 'Active' : 'Inactive'}
      </span>
    </div>

    <h2 class="font-heading font-bold text-lg text-white group-hover:text-lime-400 transition-colors leading-snug text-pretty mb-4">
      {project.title}
    </h2>

    {project.stack.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-1.5">
        {project.stack.map((item) => (
          <span class="text-[10px] font-mono text-lime-400/70 px-2 py-1 bg-lime-400/10">
            {item}
          </span>
        ))}
      </div>
    )}
  </div>
</a>

---
import { heroImage } from '../../lib/image'
import { toPublicMediaUrl, type ProjectImage } from '../../lib/content'

interface Props {
  image: ProjectImage
  title: string
}

const { image, title } = Astro.props
const publicUrl = toPublicMediaUrl(image.url, Astro.locals.emdash?.getPublicMediaUrl)
const optimized = heroImage(publicUrl)
---

{optimized && (
  <div class="overflow-hidden">
    <img
      src={optimized}
      alt={image.alt || title}
      class="w-full object-cover grayscale hover:grayscale-0 outline-1 -outline-offset-1 outline-white/10 transition-[filter] duration-300"
      loading="eager"
    />
  </div>
)}

---
import { heroImage, thumbImage } from '../../lib/image'
import type { ProjectImage } from '../../lib/content'

interface Props {
  images: ProjectImage[]
  title: string
}

const { images, title } = Astro.props
const [hero, ...rest] = images
---

{images.length > 0 && (
  <div class="flex flex-col gap-3">
    {hero && (
      <div class="overflow-hidden">
        <img
          src={heroImage(hero.url)}
          alt={hero.alt || title}
          class="w-full object-cover grayscale hover:grayscale-0 outline-1 -outline-offset-1 outline-white/10 transition-[filter] duration-300"
          loading="eager"
        />
      </div>
    )}

    {rest.length > 0 && (
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {rest.map((image) => (
          <div class="overflow-hidden aspect-[16/10]">
            <img
              src={thumbImage(image.url)}
              alt={image.alt || title}
              class="w-full h-full object-cover grayscale hover:grayscale-0 outline-1 -outline-offset-1 outline-white/10 transition-[filter] duration-300"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    )}
  </div>
)}

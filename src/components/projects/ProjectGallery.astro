---
import { projectDetailImage } from '../../lib/image'
import { toPublicMediaUrl, type ProjectImage } from '../../lib/content'

interface Props {
  image: ProjectImage
  title: string
}

const { image, title } = Astro.props
const publicUrl = toPublicMediaUrl(image.url, Astro.locals.emdash?.getPublicMediaUrl)
const optimized = projectDetailImage(publicUrl)
---

{optimized && (
  <div class="overflow-hidden">
    <img
      src={optimized}
      alt={image.alt || title}
      width="768"
      height="480"
      sizes="768px"
      class="w-full object-cover grayscale outline-1 -outline-offset-1 outline-white/10"
      loading="eager"
    />
  </div>
)}

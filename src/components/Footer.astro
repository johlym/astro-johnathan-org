---
import type { NavLink } from '../lib/content'

interface Props {
  siteTitle: string
  siteDescription?: string
  primaryLinks?: NavLink[]
  socialLinks?: NavLink[]
}

const { siteTitle, siteDescription = '', primaryLinks = [], socialLinks = [] } = Astro.props
const year = new Date().getFullYear()
---

<footer class="w-full bg-neutral-950 border-t border-neutral-800 py-12">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      <div class="flex flex-col gap-3 min-w-0">
        <div class="flex items-center gap-3">
          <div class="size-8 bg-lime-400 flex items-center justify-center shrink-0">
            <span class="text-neutral-950 text-xs font-bold leading-none">J.<br />ORG</span>
          </div>
          <span class="text-neutral-100 text-sm font-heading lowercase">{siteTitle}</span>
        </div>
        {siteDescription && (
          <p class="text-neutral-500 text-base sm:text-xs text-pretty">{siteDescription}</p>
        )}
      </div>

      <div class="flex flex-col gap-3 min-w-0">
        <p class="text-neutral-600 text-base sm:text-xs font-heading uppercase tracking-wide">Menu</p>
        {primaryLinks.length > 0 ? (
          <ul role="list" class="flex flex-col gap-2">
            {primaryLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-neutral-400 text-base sm:text-sm font-normal hover:text-lime-400 no-underline lowercase"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ) : null}
      </div>

      <div class="flex flex-col gap-3 min-w-0">
        <p class="text-neutral-600 text-base sm:text-xs font-heading uppercase tracking-wide">Socials</p>
        {socialLinks.length > 0 ? (
          <ul role="list" class="flex flex-col gap-2">
            {socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-neutral-400 text-base sm:text-sm font-normal hover:text-lime-400 no-underline lowercase"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ) : null}
      </div>

      <div class="flex flex-col gap-3 min-w-0">
        <p class="text-neutral-600 text-base sm:text-xs font-heading uppercase tracking-wide">Copyright</p>
        <p class="text-neutral-500 text-base sm:text-xs tabular-nums">
          &copy; 2014–{year} {siteTitle} – An Internet by-product by Johnathan Lyman.
        </p>
      </div>
    </div>
  </div>
</footer>

---
import Logo from './Logo.astro'
import type { NavLink } from '../lib/content'

interface Props {
  siteTitle: string
  siteDescription?: string
  primaryLinks?: NavLink[]
  socialLinks?: NavLink[]
}

const { siteTitle, siteDescription = '', primaryLinks = [], socialLinks = [] } = Astro.props
const year = new Date().getFullYear()
---

<footer class="py-20 px-6 md:px-12 bg-zinc-950 border-t border-zinc-900">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
      <div class="md:col-span-4">
        <a href="/" class="group inline-flex items-center gap-3 mb-4 no-underline">
          <Logo siteTitle={siteTitle} size="sm" />
        </a>
        {siteDescription ? (
          <p class="text-sm text-zinc-500 font-light max-w-xs leading-relaxed">
            {siteDescription}
          </p>
        ) : (
          <p class="text-sm text-zinc-500 font-light max-w-xs leading-relaxed">
            An Internet property by Johnathan Lyman. Built to archive thoughts, logs, and technical experiments.
          </p>
        )}
      </div>

      <div class="md:col-span-2 md:col-start-6">
        <h5 class="font-mono text-xs text-white uppercase tracking-wider mb-6">Menu</h5>
        {primaryLinks.length > 0 ? (
          <ul role="list" class="space-y-3">
            {primaryLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-zinc-400 hover:text-lime-400 transition-colors no-underline lowercase"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ) : null}
      </div>

      <div class="md:col-span-3">
        <h5 class="font-mono text-xs text-white uppercase tracking-wider mb-6">Socials</h5>
        {socialLinks.length > 0 ? (
          <div class="grid grid-cols-2 gap-x-4 gap-y-3">
            {socialLinks.map((link) => (
              <a
                href={link.href}
                class="text-sm text-zinc-400 hover:text-lime-400 transition-colors no-underline lowercase"
              >
                {link.label}
              </a>
            ))}
          </div>
        ) : null}
      </div>

      <div class="md:col-span-3">
        <h5 class="font-mono text-xs text-white uppercase tracking-wider mb-6">Copyright</h5>
        <p class="text-xs text-zinc-500 leading-relaxed">
          &copy; 2014–{year} {siteTitle} — An Internet by-product by Johnathan Lyman. All rights observed.
        </p>
      </div>
    </div>

    <div class="pt-8 border-t border-zinc-900 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-zinc-600 font-mono">
        Designed for absolute minimalism. Handcrafted with Astro &amp; modern layouts.
      </p>
      <button
        type="button"
        id="back-to-top"
        class="text-xs font-mono text-zinc-500 hover:text-lime-400 transition-colors flex items-center gap-1 cursor-pointer bg-transparent border-0 p-0"
      >
        Back to top ↑
      </button>
    </div>
  </div>
</footer>

<script>
  const button = document.getElementById('back-to-top')
  button?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' })
  })
</script>

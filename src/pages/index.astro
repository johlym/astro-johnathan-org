---
export const prerender = false

import Layout from '../layouts/Layout.astro'
import Hero from '../components/homepage/Hero.astro'
import PostCard from '../components/PostCard.astro'
import { getPosts } from '../lib/content'

const LIMIT = 6

type CardPost = {
  slug: string
  title: string
  date: Date
  excerpt?: string
  featuredImage?: { url?: string; alt?: string } | null
}

let recentPosts: CardPost[] = []

try {
  const posts = await getPosts(LIMIT)
  recentPosts = posts.map((p) => ({
    slug: p.slug,
    title: p.title,
    date: new Date(p.publishedAt ?? p.createdAt ?? Date.now()),
    excerpt: p.excerpt,
    featuredImage: p.featuredImage,
  }))
} catch (err) {
  console.error('[home] getPosts failed:', err)
}
---

<Layout>
  <Hero />
  {recentPosts.length > 0 && (
    <section class="w-full bg-neutral-950 pt-16 pb-20 border-t border-neutral-800">
      <div class="max-w-[1200px] mx-auto px-6">
        <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
          {recentPosts.map((post) => (
            <li class="min-w-0">
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>

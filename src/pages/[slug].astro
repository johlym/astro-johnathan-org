---
import Layout from '../layouts/Layout.astro'
import ArticleHeader from '../components/posts/ArticleHeader.astro'
import RichText from '../components/RichText.astro'
import { getAllPageSlugs, getPage, type Page } from '../lib/payload'

type Props = { page: Page }

export async function getStaticPaths() {
  const resp = await getAllPageSlugs()
  const paths: Array<{ params: { slug: string }; props: Props }> = []
  for (const s of resp.docs) {
    const full = await getPage(s.slug)
    const page = full.docs[0]
    if (!page) continue
    paths.push({ params: { slug: s.slug }, props: { page } })
  }
  return paths
}

const { page } = Astro.props as Props
---

<Layout title={page.title} description={page.excerpt}>
  <ArticleHeader
    title={page.title}
    excerpt={page.excerpt}
  />

  <section class="content-container w-full bg-neutral-950 pb-16">
    <div class="max-w-3xl mx-auto px-6">
      <RichText content={page.body} class="rich-text" />
    </div>
  </section>
</Layout>

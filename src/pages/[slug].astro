---
export const prerender = false

import Layout from '../layouts/Layout.astro'
import ArticleHeader from '../components/posts/ArticleHeader.astro'
import RichText from '../components/RichText.astro'
import { getPage } from '../lib/content'

const slug = Astro.params.slug
if (!slug) {
  return Astro.redirect('/404')
}

// Reserved routes handled by dedicated pages
if (['blog', 'links', 'api', '_emdash'].includes(slug)) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const page = await getPage(slug).catch(() => null)
if (!page) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}
---

<Layout title={page.title} description={page.excerpt}>
  <ArticleHeader
    title={page.title}
    excerpt={page.excerpt}
  />

  <section class="content-container w-full bg-neutral-950 pb-16">
    <div class="max-w-3xl mx-auto px-6">
      <RichText content={page.body} class="rich-text" />
    </div>
  </section>
</Layout>

---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import RichText from '../../components/RichText.astro'
import ProjectGallery from '../../components/projects/ProjectGallery.astro'
import { getProject } from '../../lib/content'
import { tagContentEntry } from '../../lib/route-cache'

const slug = Astro.params.slug
if (!slug) {
  return Astro.redirect('/404')
}

const project = await getProject(slug).catch(() => null)
if (!project) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

tagContentEntry(Astro.cache, 'projects', project.id)

const edit = project.edit

function displayHost(url: string) {
  try {
    return new URL(url).host.replace(/^www\./, '')
  } catch {
    return url
  }
}
---

<Layout title={project.title} description={`${project.title} — a project by Johnathan Lyman`}>
  {project.isPreview && (
    <div class="w-full bg-lime-400 text-zinc-950 text-center text-xs font-mono uppercase tracking-wide py-2">
      Viewing preview. This content is not published.
    </div>
  )}

  <article class="py-16 md:py-24 px-6 md:px-12 bg-zinc-950" {...edit}>
    <div class="max-w-3xl mx-auto">
      <header class="mb-12 pb-10 border-b border-zinc-900">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 text-xs font-mono text-zinc-500 hover:text-lime-400 transition-colors mb-8 group no-underline"
        >
          <svg
            class="w-4 h-4 transition-transform group-hover:-translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back to all projects</span>
        </a>

        {project.url && (
          <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-zinc-500 mb-6">
            <a
              href={project.url}
              class="text-lime-400 hover:text-lime-300 no-underline"
              rel="noopener noreferrer"
              target="_blank"
              {...edit?.project_url}
            >
              {displayHost(project.url)}
            </a>
          </div>
        )}

        <h1
          class="font-heading text-3xl md:text-5xl font-bold text-white leading-tight mb-6 text-pretty"
          {...edit?.project_name}
        >
          {project.title}
        </h1>

        {project.stack.length > 0 && (
          <div class="flex flex-wrap gap-1.5" {...edit?.stack}>
            {project.stack.map((item) => (
              <span class="text-[10px] font-mono text-lime-400/70 px-2 py-1 bg-lime-400/10">
                {item}
              </span>
            ))}
          </div>
        )}
      </header>

      {project.screenshot && (
        <div class="mb-12" {...edit?.screenshot}>
          <ProjectGallery image={project.screenshot} title={project.title} />
        </div>
      )}

      <div class="min-w-0" {...edit?.description}>
        <RichText content={project.description} class="rich-text" />
      </div>
    </div>
  </article>
</Layout>

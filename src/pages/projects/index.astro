---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import ProjectCard from '../../components/projects/ProjectCard.astro'
import { getProjects } from '../../lib/content'

let projects: Awaited<ReturnType<typeof getProjects>> = []

try {
  projects = await getProjects()
} catch (err) {
  console.error('[projects] getProjects failed:', err)
}
---

<Layout title="Projects" description="Past work and featured projects">
  <header class="py-16 md:py-24 px-6 md:px-12 border-b border-zinc-900 bg-zinc-950">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-8">
      <div>
        <p class="font-mono text-xs text-lime-400 uppercase tracking-widest mb-3">Portfolio</p>
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-white tracking-tight">
          Projects
        </h1>
      </div>
      <p class="text-sm text-zinc-500 font-mono max-w-md">
        Past work, experiments, and things that are still running.
      </p>
    </div>
  </header>

  <section class="py-16 md:py-24 px-6 md:px-12 bg-zinc-950">
    <div class="max-w-7xl mx-auto">
      {projects.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="text-zinc-500 text-sm font-mono">No projects yet.</p>
      )}
    </div>
  </section>
</Layout>

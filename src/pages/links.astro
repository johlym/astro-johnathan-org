---
export const prerender = false

import Layout from '../layouts/Layout.astro'
import RichText from '../components/RichText.astro'
import { getPage } from '../lib/content'
import RaindropIoLinks from '../components/RaindropIoLinks.astro'
import { tagContentEntry } from '../lib/route-cache'

const page = await getPage('links').catch(() => null)

if (!page) {
  return new Response(
    'Missing EmDash page with slug "links" — create and publish it in /_emdash/admin.',
    { status: 503, statusText: 'Service Unavailable' },
  )
}

tagContentEntry(Astro.cache, 'pages', page.id)
const edit = page.edit
---

<Layout title={page.title} description={page.excerpt}>
  {page.isPreview && (
    <div class="w-full bg-lime-400 text-zinc-950 text-center text-xs font-mono uppercase tracking-wide py-2">
      Viewing preview. This content is not published.
    </div>
  )}

  <article class="w-full bg-zinc-950" {...edit}>
    <header class="py-16 md:py-24 px-6 md:px-12 border-b border-zinc-900">
      <div class="max-w-3xl mx-auto">
        <p class="font-mono text-xs text-lime-400 uppercase tracking-widest mb-3">Directory</p>
        <h1 class="font-heading text-3xl md:text-5xl font-bold text-white tracking-tight text-pretty" {...edit?.title}>
          {page.title}
        </h1>
        {page.excerpt && (
          <p class="text-lg text-zinc-400 font-light leading-relaxed mt-6" {...edit?.excerpt}>
            {page.excerpt}
          </p>
        )}
      </div>
    </header>

    <section class="content-container py-16 md:py-20 px-6 md:px-12">
      <div class="max-w-3xl mx-auto flex flex-col gap-10" {...edit?.body}>
        <RichText content={page.body} class="rich-text" />
        <RaindropIoLinks />
      </div>
    </section>
  </article>
</Layout>

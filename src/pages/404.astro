---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404">
  <section class="w-full bg-zinc-950 border-b border-zinc-900 flex-1 flex items-center justify-center" style="min-height: calc(100vh - 13rem);">
    <div class="max-w-2xl mx-auto px-6 py-10 w-full">
      <div class="flex flex-col items-center text-center">
        <div class="relative mb-8">
          <p class="text-[10rem] md:text-[14rem] font-heading font-bold text-zinc-900 leading-none select-none">404</p>
        </div>
        <h1 class="text-white text-3xl md:text-4xl font-heading font-bold leading-tight mb-4">sh*t's broke</h1>
        <p class="text-zinc-500 text-sm leading-relaxed max-w-md mb-10">
          the page you were looking for isn't here.<br />
          maybe it was never here.<br />
          maybe it was, and decided to leave.<br />
          these pages have free wills and i'm not about to tell them what to do.
        </p>
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-zinc-900 hover:bg-lime-400 hover:text-black border border-zinc-800 text-sm font-medium px-4 py-2 transition-all duration-300 no-underline text-zinc-100"
        >
          <span>Back home</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

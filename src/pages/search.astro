---
export const prerender = false

import Layout from '../layouts/Layout.astro'
import { searchSite } from '../lib/content'

const q = (Astro.url.searchParams.get('q') ?? '').trim()

let results: { collection: string; slug: string | null; title?: string; snippet?: string }[] = []
if (q) {
  const response = await searchSite(q, 30)
  results = (response.items ?? []).map((item) => ({
    collection: item.collection,
    slug: item.slug,
    title: item.title,
    snippet: item.snippet,
  }))
}

function hrefFor(item: (typeof results)[number]) {
  if (!item.slug) return '#'
  if (item.collection === 'posts') return `/blog/${item.slug}`
  return `/${item.slug}`
}
---

<Layout title={q ? `Search: ${q}` : 'Search'} description="Search posts and pages">
  <section class="w-full bg-zinc-950 py-16 md:py-24 px-6 md:px-12 border-b border-zinc-900">
    <div class="max-w-7xl mx-auto flex flex-col gap-8">
      <div>
        <p class="font-mono text-xs text-lime-400 uppercase tracking-widest mb-3">Search</p>
        <h1 class="font-heading text-3xl md:text-5xl font-bold text-white tracking-tight">Find something</h1>
      </div>

      <form action="/search" method="get" class="flex flex-col sm:flex-row gap-3" role="search">
        <label class="sr-only" for="search-q">Search query</label>
        <input
          id="search-q"
          type="search"
          name="q"
          value={q}
          placeholder="Search posts and pages…"
          class="grow min-w-0 bg-zinc-900 border border-zinc-800 px-4 py-2.5 text-sm text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-lime-400/40 font-mono"
        />
        <button
          type="submit"
          class="shrink-0 bg-zinc-900 hover:bg-lime-400 hover:text-black border border-zinc-800 text-sm font-medium px-5 py-2.5 transition-all duration-300"
        >
          Search
        </button>
      </form>
    </div>
  </section>

  <section class="w-full bg-zinc-950 py-12 px-6 md:px-12">
    <div class="max-w-7xl mx-auto flex flex-col gap-8">
      {!q && (
        <p class="text-zinc-500 text-sm font-mono">Enter a query to search.</p>
      )}

      {q && results.length === 0 && (
        <p class="text-zinc-500 text-sm font-mono">No results for “{q}”.</p>
      )}

      {results.length > 0 && (
        <ul role="list" class="flex flex-col gap-1">
          {results.map((item) => (
            <li>
              <a
                href={hrefFor(item)}
                class="archive-entry group flex flex-col gap-2 p-5 bg-zinc-900/20 border border-zinc-900 hover:border-lime-400/30 hover:bg-zinc-900/40 transition-all duration-300 no-underline"
              >
                <p class="text-zinc-600 text-[10px] font-mono uppercase tracking-wider">
                  {item.collection}
                </p>
                <span class="font-heading font-semibold text-white group-hover:text-lime-400 transition-colors text-pretty">
                  {item.title || item.slug || 'Untitled'}
                </span>
                {item.snippet && (
                  <p class="text-zinc-500 text-sm text-pretty" set:html={item.snippet} />
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Layout>

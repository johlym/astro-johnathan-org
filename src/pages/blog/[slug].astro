---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import Content from '../../components/Content.astro'
import ArticleHeader from '../../components/posts/ArticleHeader.astro'
import FeaturedImage from '../../components/posts/FeaturedImage.astro'
import RichText from '../../components/RichText.astro'
import { getPost } from '../../lib/content'

const slug = Astro.params.slug
if (!slug) {
  return Astro.redirect('/404')
}

const post = await getPost(slug).catch(() => null)
if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const title = post.title
const dateObj = new Date(post.publishedAt ?? post.createdAt ?? Date.now())
const excerpt = post.excerpt
const body = post.body
const category = post.category
const featuredImageUrl = post.featuredImage?.url ?? null
const featuredImageAlt = post.featuredImage?.alt ?? ''
const rawText = JSON.stringify(post.body ?? '').replace(/[#*`[\]()>_~|!{}",:]+/g, ' ')
const wordCount = rawText.replace(/\s+/g, ' ').trim().split(' ').filter(Boolean).length.toLocaleString('en-US')
---

<Layout title={title} description={excerpt}>
  <ArticleHeader
    title={title}
    excerpt={excerpt}
    date={dateObj}
    category={category}
    backHref="/blog"
    backLabel="Back to posts"
    showAuthorMeta={true}
    wordCount={wordCount}
  />

  <Content>
    {featuredImageUrl && (
      <FeaturedImage src={featuredImageUrl} alt={featuredImageAlt} />
    )}

    <RichText content={body} class="rich-text" />
  </Content>
</Layout>

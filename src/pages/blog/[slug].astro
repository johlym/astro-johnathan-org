---
import Layout from '../../layouts/Layout.astro'
import Content from '../../components/Content.astro'
import ArticleHeader from '../../components/posts/ArticleHeader.astro'
import TableOfContents from '../../components/posts/TableOfContents.astro'
import FeaturedImage from '../../components/posts/FeaturedImage.astro'

import { getAllPostSlugs, getPost, type Post } from '../../lib/payload'
import { lexicalToHtml, extractHeadings, processFootnotes } from '../../lib/richtext'
import { render } from 'astro:content'
import { getMdPosts, type MdPost } from '../../lib/mdposts'

type Props = {
  source: 'md'
  mdEntry: MdPost
} | {
  source: 'cms'
  post: Post
}

export async function getStaticPaths() {
  const [mdPosts, cmsResp] = await Promise.all([
    getMdPosts(),
    getAllPostSlugs(),
  ])

  const mdSlugs = new Set(mdPosts.map((e) => e.slug))
  const paths: Array<{ params: { slug: string }; props: Props }> = []

  for (const mdEntry of mdPosts) {
    paths.push({
      params: { slug: mdEntry.slug },
      props: { source: 'md', mdEntry },
    })
  }

  for (const cms of cmsResp.docs) {
    if (mdSlugs.has(cms.slug)) continue
    const full = await getPost(cms.slug)
    const post = full.docs[0]
    if (!post) continue
    paths.push({
      params: { slug: cms.slug },
      props: { source: 'cms', post },
    })
  }

  return paths
}

const props = Astro.props as Props

type TocItem = { id: string; text: string; depth?: number; tag?: string }

let title = ''
let dateObj: Date | null = null
let excerpt: string | undefined
let category: string | undefined
let tocItems: TocItem[] = []
let showToc = false
let MdContent: ((_props: Record<string, unknown>) => unknown) | null = null
let bodyHtml = ''
let authorName: string | null = null
let categoryTitle: string | null = null
let featuredImageUrl: string | null = null
let featuredImageAlt = ''

if (props.source === 'md') {
  const { mdEntry } = props
  const { Content, headings } = await render(mdEntry)
  title = mdEntry.data.title
  dateObj = mdEntry.data.date
  excerpt = mdEntry.data.excerpt ?? mdEntry.data.description
  category = mdEntry.data.category
  MdContent = Content as (_props: Record<string, unknown>) => unknown
  tocItems = headings
    .filter((h) => h.depth <= 3)
    .map((h) => ({ id: h.slug, text: h.text, depth: h.depth }))
  showToc = tocItems.length > 0
} else {
  const { post } = props
  title = post.title
  dateObj = new Date(post.createdAt)
  excerpt = post.excerpt
  bodyHtml = processFootnotes(lexicalToHtml(post.body))
  const rawHeadings = extractHeadings(post.body)
  tocItems = rawHeadings.map((h) => ({ id: h.id, text: h.text, tag: h.tag }))
  showToc = tocItems.length > 0
  authorName =
    post.author && typeof post.author === 'object' && 'name' in post.author
      ? (post.author as { name: string }).name
      : null
  categoryTitle =
    post.category && typeof post.category === 'object' && 'title' in post.category
      ? (post.category as { title: string }).title
      : null
  featuredImageUrl =
    post.featuredImage && typeof post.featuredImage === 'object' && 'url' in post.featuredImage
      ? (post.featuredImage as { url: string }).url
      : null
  featuredImageAlt =
    post.featuredImage && typeof post.featuredImage === 'object' && 'alt' in post.featuredImage
      ? String((post.featuredImage as { alt?: string }).alt ?? '')
      : ''
}

const metaCategory = category ?? categoryTitle
const rawText = props.source === 'md'
  ? (props.mdEntry.body ?? '').replace(/[#*`[\]()>_~|!]+/g, ' ')
  : bodyHtml.replace(/<[^>]+>/g, ' ')
const wordCount = rawText.replace(/\s+/g, ' ').trim().split(' ').filter(Boolean).length.toLocaleString('en-US')
---

<Layout title={title} description={excerpt}>
  <ArticleHeader
    title={title}
    excerpt={excerpt}
    date={dateObj ?? undefined}
    authorName={authorName ?? undefined}
    category={metaCategory}
    backHref="/blog"
    backLabel="Back to posts"
    showAuthorMeta={true}
    wordCount={wordCount}
  />

  <Content>
    {showToc && (
      <TableOfContents items={tocItems} />
    )}

    {featuredImageUrl && (
      <FeaturedImage src={featuredImageUrl} alt={featuredImageAlt} />
    )}

    {MdContent
      ? <div class="rich-text"><MdContent /></div>
      : <div class="rich-text" set:html={bodyHtml} />
    }
  </Content>
</Layout>

---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import BlogArchive from '../../components/blog/BlogArchive.astro'
import FeaturedImage from '../../components/posts/FeaturedImage.astro'
import RichText from '../../components/RichText.astro'
import PostCard from '../../components/PostCard.astro'
import {
  getCategory,
  getPaginatedPostsByCategory,
  getPost,
  getRelatedPosts,
  wordCountFromBody,
  type EmDashPost,
} from '../../lib/content'
import { formatPostDate, readingMinutes } from '../../lib/format'
import type { TaxonomyTerm } from 'emdash'

const slug = Astro.params.slug
if (!slug) {
  return Astro.redirect('/404')
}

// Prefer an existing post so established /blog/$postSlug URLs keep working.
// Otherwise treat the slug as a category archive (/blog/$category-slug).
const post = await getPost(slug).catch(() => null)

let mode: 'post' | 'category' = 'post'
let category: TaxonomyTerm | null = null
let archivePosts: EmDashPost[] = []
let archivePage = 1
let archiveTotalPages = 1
let archiveTotal = 0
let archiveBasePath = '/blog'

if (!post) {
  category = await getCategory(slug).catch(() => null)
  if (!category) {
    return new Response(null, { status: 404, statusText: 'Not Found' })
  }

  mode = 'category'
  archiveBasePath = `/blog/${category.slug}`

  const rawPage = Number(Astro.url.searchParams.get('page') ?? '1')
  const requestedPage = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1

  try {
    const result = await getPaginatedPostsByCategory(category.slug, requestedPage)
    archivePosts = result.posts
    archivePage = result.page
    archiveTotalPages = result.totalPages
    archiveTotal = result.total

    if (requestedPage > archiveTotalPages && archiveTotalPages >= 1) {
      return Astro.redirect(
        archiveTotalPages === 1 ? archiveBasePath : `${archiveBasePath}?page=${archiveTotalPages}`,
      )
    }
  } catch (err) {
    console.error('[blog/category] getPaginatedPostsByCategory failed:', err)
  }
}

const title = post?.title ?? ''
const excerpt = post?.excerpt
const body = post?.body
const categories = post?.categories ?? []
const primaryCategory = categories[0]
const primaryCategorySlug = primaryCategory?.slug
const featuredImageUrl = post?.featuredImage?.url ?? null
const featuredImageAlt = post?.featuredImage?.alt ?? ''
const wordCount = post ? wordCountFromBody(post.body) : '0'
const minutes = post ? readingMinutes(post.body) : 1
const publishedAt = post
  ? new Date(post.publishedAt ?? post.createdAt ?? Date.now())
  : null
const edit = post?.edit

let related: EmDashPost[] = []
if (mode === 'post' && post) {
  related = await getRelatedPosts(primaryCategorySlug, post.id, 3)
}

const pageTitle =
  mode === 'category' && category ? `${category.label} — Blog` : title
const pageDescription =
  mode === 'category' && category
    ? `Posts filed under ${category.label}`
    : excerpt
---

{mode === 'category' && category ? (
  <Layout title={pageTitle} description={pageDescription}>
    <BlogArchive
      posts={archivePosts}
      page={archivePage}
      totalPages={archiveTotalPages}
      total={archiveTotal}
      basePath={archiveBasePath}
      subtitle={category.label}
      title={category.label}
      activeCategory={category.slug}
    />
  </Layout>
) : (
  <Layout title={pageTitle} description={pageDescription}>
    {post?.isPreview && (
      <div class="w-full bg-lime-400 text-zinc-950 text-center text-xs font-mono uppercase tracking-wide py-2">
        Viewing preview. This content is not published.
      </div>
    )}

    <article class="py-16 md:py-24 px-6 md:px-12 bg-zinc-950" {...edit}>
      <div class="max-w-3xl mx-auto">
        <header class="mb-12 pb-10 border-b border-zinc-900">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-xs font-mono text-zinc-500 hover:text-lime-400 transition-colors mb-8 group no-underline"
          >
            <svg
              class="w-4 h-4 transition-transform group-hover:-translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back to all posts</span>
          </a>

          <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-zinc-500 mb-6">
            {publishedAt && (
              <time datetime={publishedAt.toISOString()}>
                {formatPostDate(publishedAt)}
              </time>
            )}
            {primaryCategory && (
              <>
                <span class="w-1 h-1 rounded-full bg-zinc-700" aria-hidden="true"></span>
                <a
                  href={`/blog/${encodeURIComponent(primaryCategory.slug)}`}
                  class="text-lime-400 hover:text-lime-300 no-underline"
                >
                  {primaryCategory.label}
                </a>
              </>
            )}
            <span class="w-1 h-1 rounded-full bg-zinc-700" aria-hidden="true"></span>
            <span>{minutes} min read</span>
            <span class="w-1 h-1 rounded-full bg-zinc-700" aria-hidden="true"></span>
            <span>{wordCount} words</span>
          </div>

          <h1
            class="font-heading text-3xl md:text-5xl font-bold text-white leading-tight mb-6 text-pretty"
            {...edit?.title}
          >
            {title}
          </h1>

          {excerpt && (
            <p class="text-lg text-zinc-400 font-light leading-relaxed" {...edit?.excerpt}>
              {excerpt}
            </p>
          )}
        </header>

        <div class="min-w-0" {...edit?.body}>
          {featuredImageUrl && (
            <div class="mb-10" {...edit?.featured_image}>
              <FeaturedImage src={featuredImageUrl} alt={featuredImageAlt} />
            </div>
          )}
          <RichText content={body} class="rich-text" />
        </div>
      </div>
    </article>

    <section class="py-16 px-6 md:px-12 bg-zinc-950 border-t border-zinc-900">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-6 p-6 bg-zinc-900/30 border border-zinc-900 rounded-lg">
          <div class="w-16 h-16 bg-zinc-800 rounded-full flex items-center justify-center flex-shrink-0">
            <span class="font-heading font-bold text-xl text-lime-400">JL</span>
          </div>
          <div>
            <h3 class="font-heading font-bold text-white mb-1">Johnathan Lyman</h3>
            <p class="text-sm text-zinc-500 leading-relaxed">
              Software engineer, data tinkerer, and occasional weather enthusiast. Writing about technology, observations, and whatever catches my attention.
            </p>
          </div>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="py-16 md:py-20 px-6 md:px-12 bg-zinc-950 border-t border-zinc-900">
        <div class="max-w-7xl mx-auto">
          <div class="flex items-center justify-between mb-10">
            <h2 class="font-heading text-2xl font-bold text-white">Related Posts</h2>
            <a
              href="/blog"
              class="text-xs font-mono text-zinc-500 hover:text-lime-400 transition-colors no-underline"
            >
              View all posts →
            </a>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {related.map((item) => (
              <PostCard
                post={{
                  slug: item.slug,
                  title: item.title,
                  date: new Date(item.publishedAt ?? item.createdAt ?? Date.now()),
                  excerpt: item.excerpt,
                  category: item.category,
                  tags: item.categories.map((c) => c.label),
                }}
                variant="related"
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </Layout>
)}

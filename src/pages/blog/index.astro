---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import BlogArchive from '../../components/blog/BlogArchive.astro'
import { getPaginatedPosts } from '../../lib/content'

// Legacy query-param category links → /blog/$slug
const legacyCategory = Astro.url.searchParams.get('category')
if (legacyCategory) {
  const params = new URLSearchParams(Astro.url.searchParams)
  params.delete('category')
  const qs = params.toString()
  return Astro.redirect(`/blog/${encodeURIComponent(legacyCategory)}${qs ? `?${qs}` : ''}`, 301)
}

const rawPage = Number(Astro.url.searchParams.get('page') ?? '1')
const requestedPage = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1

let posts: Awaited<ReturnType<typeof getPaginatedPosts>>['posts'] = []
let page = 1
let totalPages = 1

try {
  const result = await getPaginatedPosts(requestedPage)
  posts = result.posts
  page = result.page
  totalPages = result.totalPages

  if (requestedPage > totalPages && totalPages >= 1) {
    return Astro.redirect(totalPages === 1 ? '/blog' : `/blog?page=${totalPages}`)
  }
} catch (err) {
  console.error('[blog] getPaginatedPosts failed:', err)
}
---

<Layout title="Blog">
  <BlogArchive posts={posts} page={page} totalPages={totalPages} />
</Layout>

---
import '../styles/globals.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { getSiteSettings, getPrimaryNav, getSocialsNav } from '../lib/content'

interface Props {
  title?: string
  description?: string
}

const { title, description } = Astro.props

let siteTitle = 'Johnathan.org'
let siteDescription = ''
let navLinks: { href: string; label: string }[] = []
let socialLinks: { href: string; label: string }[] = []

try {
  const settings = await getSiteSettings()
  siteTitle = settings.siteTitle || 'Johnathan.org'
  siteDescription = settings.siteDescription || ''
} catch {
  // fallback
}

try {
  navLinks = await getPrimaryNav()
} catch {
  // fallback
}

try {
  socialLinks = await getSocialsNav()
} catch {
  // fallback
}

const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle
const pageDescription = description || siteDescription

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300')
---

<html lang="en" class="scheme-only-dark antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://cdn.usefathom.com/script.js" data-site="PSXSYBXV" defer></script>
  </head>
  <body class="min-h-dvh flex flex-col bg-zinc-950 text-zinc-100 isolate font-body selection:bg-lime-400 selection:text-black">
    <Header siteTitle={siteTitle} navLinks={navLinks} />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer
      siteTitle={siteTitle}
      siteDescription={siteDescription}
      primaryLinks={navLinks}
      socialLinks={socialLinks}
    />
  </body>
</html>

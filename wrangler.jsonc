/**
 * Cloudflare Workers config for johnathan-org-frontend.
 *
 * EmDash + Astro SSR Worker with D1 (content) and R2 (media).
 * Custom domains (johnathan.org, www.johnathan.org) are attached via
 * the dashboard so DNS conflicts stay visible.
 *
 * Docs: https://docs.emdashcms.com/deployment/cloudflare/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "johnathan-org-frontend",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "johnathan-org-emdash",
      "database_id": "8656333c-aafb-4a71-9be2-c45fd43b92d9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "johnathan-org-media"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}

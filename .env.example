# Optional override for the Cloudflare zone that serves /cdn-cgi/image
# transforms. Defaults to https://johnathan.org.
PUBLIC_IMAGE_HOST=

# Optional public R2 / custom media host used at build time when bundling
# with Cloudflare bindings (EMDASH_CLOUDFLARE=1 or `astro build`).
PUBLIC_MEDIA_URL=

# Raindrop proxy (Worker secret in production).
RAINDROP_API_TEST_TOKEN=

# Bento transactional email (Worker secrets in production).
BENTO_SITE_UUID=
BENTO_PUBLISHABLE_KEY=
BENTO_SECRET_KEY=

# EmDash plugin secret encryption (Worker secret in production).
EMDASH_ENCRYPTION_KEY=

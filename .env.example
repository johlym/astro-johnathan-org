# URL of the Payload backend used at BUILD TIME to fetch pages/posts.
# Set as a Build Variable in Workers Builds. Not needed at runtime —
# the frontend is fully static.
PAYLOAD_API_URL=https://cms.johnathan.org

# Optional override for the Cloudflare zone that serves /cdn-cgi/image
# transforms. Defaults to https://johnathan.org.
PUBLIC_IMAGE_HOST=
